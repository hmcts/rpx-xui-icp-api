#!groovy

@Library("Infrastructure@2.4.4") _

import uk.gov.hmcts.pipeline.TeamConfig

def product = 'xui'
def component = 'icp-api'

// Stage A proves the scheduled destination build without publishing or deploying it.
if (env.BRANCH_NAME != 'master') {
  error('EXUI-5084 Stage A: the build-only nightly pipeline may run only from master.')
}

properties([
  [
    $class       : 'GithubProjectProperty',
    displayName  : 'Presenting Evidence Digitally Backend API',
    projectUrlStr: 'https://github.com/hmcts/rpx-xui-icp-api'
  ],
  pipelineTriggers([cron('H 8 * * 1-5')])
])

new TeamConfig(this).setTeamConfigEnv(product)

def agentType = env.BUILD_AGENT_TYPE
def nodeSelector = agentType == '' ? 'daily' : agentType in ['civil', 'xui'] ? agentType : "${agentType} && daily"

node(nodeSelector) {
  timeout(time: 30, unit: 'MINUTES') {
    try {
      dockerAgentSetup()
      env.PATH = "$env.PATH:/usr/local/bin"

      stage('Checkout') {
        checkout scm
      }

      stage("Build and test ${product}/${component}") {
        sh '''
          mkdir -p "$HOME/.local/bin"
          corepack enable --install-directory "$HOME/.local/bin"
          export PATH="$HOME/.local/bin:$PATH"
          yarn --version
          yarn install --check-cache
          yarn lint
          yarn test
        '''
      }
    } finally {
      deleteDir()
    }
  }
}
