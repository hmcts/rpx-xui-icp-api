#!groovy

properties([
  pipelineTriggers([cron('H 8 * * 1-5')])
])

@Library("Infrastructure@2.5.1")

def type = "nodejs"
def product = "xui"
def component = "icp-api"
def channel = '#xui-pipeline'
def playwrightFunctionalOutputRoot = 'functional-output/tests/playwright-functional'
def playwrightFunctionalReportFile = 'xui-playwright-functional.html'

def configurePlaywrightFunctional = { String targetEnvironment ->
  env.PLAYWRIGHT_TEST_OUTPUT_DIR = "${playwrightFunctionalOutputRoot}/test-results"
  env.PLAYWRIGHT_JUNIT_OUTPUT = "${playwrightFunctionalOutputRoot}/playwright-functional-result.xml"
  env.PLAYWRIGHT_REPORT_FOLDER = "${playwrightFunctionalOutputRoot}/odhin-report"
  env.PLAYWRIGHT_REPORT_INDEX_FILENAME = playwrightFunctionalReportFile
  env.PLAYWRIGHT_REPORT_TITLE = "RPX XUI ICP API Playwright Functional (${targetEnvironment})"
  env.TEST_TYPE = targetEnvironment
  env.FUNCTIONAL_TEST_ALLOWED_ORIGIN = targetEnvironment == 'prod' ?
    'https://manage-case.platform.hmcts.net' :
    "https://manage-case.${targetEnvironment}.platform.hmcts.net"
  env.FUNCTIONAL_TEST_EXPECTED_WS_HOST = targetEnvironment == 'prod' ?
    'xui-icp-webpubsub.platform.hmcts.net' :
    "xui-icp-webpubsub.${targetEnvironment}.platform.hmcts.net"
}

def publishPlaywrightFunctional = { String reportName ->
  steps.sh("node scripts/ensure-odhin-report.js --report-dir '${playwrightFunctionalOutputRoot}/odhin-report' --report-file '${playwrightFunctionalReportFile}' --suite-name '${reportName}'")
  steps.publishHTML([
    allowMissing         : false,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : "${playwrightFunctionalOutputRoot}/odhin-report/",
    reportFiles          : playwrightFunctionalReportFile,
    reportName           : reportName
  ])
  steps.archiveArtifacts(allowEmptyArchive: true, artifacts: "${playwrightFunctionalOutputRoot}/**")
}

env.TEST_URL = "http://xui-icp-aat.service.core-compute-aat.internal"
env.IDAM_API_BASE_URL = "https://idam-api.aat.platform.hmcts.net"
env.IDAM_WEBSHOW_WHITELIST = 'https://em-show-aat.service.core-compute-aat.internal/oauth2/callback'
env.REDIS_HOST = "xui-icp-api-redis-cache-aat.redis.cache.windows.net"
env.REDIS_PORT = 6380

def secrets = [
  'rpx-${env}': [
    secret('microservicekey-em-gw', 'FUNCTIONAL_TEST_CLIENT_S2S_TOKEN'),
    secret('show-oauth2-token', 'FUNCTIONAL_TEST_CLIENT_OAUTH_SECRET'),
    secret('password', 'FUNCTIONAL_TEST_USER_PASSWORD')
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [$class: 'AzureKeyVaultSecret', secretType: 'Secret', name: secretName, version: '', envVariable: envVar]
}

withNightlyPipeline(type, product, component) {
  enableSlackNotifications(channel)
  loadVaultSecrets(secrets)
  enableFullFunctionalTest(200)

  before('fullFunctionalTest:aat') {
    configurePlaywrightFunctional('aat')
  }
  afterAlways('fullFunctionalTest:aat') {
    publishPlaywrightFunctional('Nightly XUI ICP API Functional Test')
  }
}
