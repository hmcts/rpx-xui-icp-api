#!groovy

@Library("Infrastructure@2.5.1") _

import uk.gov.hmcts.pipeline.TeamConfig

def product = 'xui'
def component = 'icp-api'

// Stage A validates the destination repository without publishing or deploying it.
if (!(env.BRANCH_NAME == 'master' || env.BRANCH_NAME ==~ /^PR-\d+$/)) {
  error('EXUI-5084 Stage A: only master and pull requests may run the build-only pipeline.')
}

properties([
  [
    $class       : 'GithubProjectProperty',
    displayName  : 'Presenting Evidence Digitally Backend API',
    projectUrlStr: 'https://github.com/hmcts/rpx-xui-icp-api'
  ],
  pipelineTriggers([
    [$class: 'GitHubPushTrigger']
  ])
])

new TeamConfig(this).setTeamConfigEnv(product)

node(env.BUILD_AGENT_TYPE) {
  timeout(time: 30, unit: 'MINUTES') {
    try {
      dockerAgentSetup()
      env.PATH = "$env.PATH:/usr/local/bin"

      stage('Checkout') {
        checkout scm
      }

      stage("Build and test ${product}/${component}") {
        sh '''
          mkdir -p "$HOME/.local/bin"
          corepack enable --install-directory "$HOME/.local/bin"
          export PATH="$HOME/.local/bin:$PATH"
          yarn --version
          yarn install
          yarn lint
          yarn test
        '''
      }
    } finally {
      deleteDir()
    }
  }
}
